<UserControl x:Class="RgbStudio.Controls.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <StackPanel>
        <!-- Doygunluk (yatay) / Parlaklik (dikey) alani -->
        <Border x:Name="SvBorder" Height="170" CornerRadius="6" ClipToBounds="True"
                BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                MouseLeftButtonDown="Sv_MouseDown" MouseMove="Sv_MouseMove" MouseLeftButtonUp="Any_MouseUp"
                Cursor="Cross">
            <Grid x:Name="SvArea" Background="Red">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="White" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="Black" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="SvCanvas" IsHitTestVisible="False">
                    <Ellipse x:Name="SvThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2.5">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <!-- Ton cubugu -->
        <Border x:Name="HueBorder" Height="16" CornerRadius="8" Margin="0,12,0,0" ClipToBounds="True"
                MouseLeftButtonDown="Hue_MouseDown" MouseMove="Hue_MouseMove" MouseLeftButtonUp="Any_MouseUp"
                Cursor="Hand">
            <Grid>
                <Rectangle RadiusX="8" RadiusY="8">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF0000" Offset="0" />
                            <GradientStop Color="#FFFF00" Offset="0.1667" />
                            <GradientStop Color="#00FF00" Offset="0.3333" />
                            <GradientStop Color="#00FFFF" Offset="0.5" />
                            <GradientStop Color="#0000FF" Offset="0.6667" />
                            <GradientStop Color="#FF00FF" Offset="0.8333" />
                            <GradientStop Color="#FF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Canvas x:Name="HueCanvas" IsHitTestVisible="False">
                    <Ellipse x:Name="HueThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2.5">
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="4" ShadowDepth="0" Opacity="0.8" />
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>
        </Border>

        <!-- Onizleme + HEX + RGB -->
        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Preview" Width="36" Height="36" CornerRadius="6" HorizontalAlignment="Left"
                    BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <ui:TextBox x:Name="HexBox" Grid.Column="1" PlaceholderText="#RRGGBB" MaxLength="7"
                        FontFamily="Consolas" LostFocus="HexBox_Commit" KeyDown="HexBox_KeyDown"
                        TextChanged="HexBox_TextChanged" />
        </Grid>

        <!-- Hazir renkler -->
        <ItemsControl x:Name="Swatches" Margin="0,12,0,0">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Width="26" Height="26" Margin="0,0,6,6" Padding="0" Cursor="Hand"
                            Click="Swatch_Click" Tag="{Binding Hex}" ToolTip="{Binding Hex}" AutomationProperties.Name="{Binding Hex}"
                            BorderThickness="1" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="13" Background="{Binding Brush}"
                                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" />
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
