<UserControl x:Class="RgbStudio.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,8,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Image Source="pack://application:,,,/Assets/app.png" Width="64" Height="64" Margin="0,0,16,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="RGB Studio" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>

            <ui:Card Margin="0,0,0,16">
                <TextBlock TextWrapping="Wrap" Style="{StaticResource Caption}" FontSize="13">
                    Bilgisayardaki bütün RGB ışıkları tek yerden yönetmek için yazıldı: her LED'i ayrı renklendirme,
                    canlı efektler, JSON senaryolar, uyku ve açılış sonrası geri yükleme. Donanıma kendisi doğrudan
                    yazmaz; aşağıdaki güvenilir açık kaynak projeler ve üretici SDK'ları üzerinden çalışır.
                </TextBlock>
            </ui:Card>

            <TextBlock Text="Krediler" Style="{StaticResource SectionTitle}" />
            <ItemsControl x:Name="Credits">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                                        <TextBlock Text="{Binding Author}" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                    <Border Grid.Column="1" CornerRadius="4" Padding="8,2" VerticalAlignment="Top"
                                            Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                        <TextBlock Text="{Binding License}" FontSize="11" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Role}" TextWrapping="Wrap" Margin="0,6,0,4" />
                                <TextBlock>
                                    <Hyperlink NavigateUri="{Binding Url}" RequestNavigate="Link_RequestNavigate"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                        <Run Text="{Binding Url, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Style="{StaticResource Caption}" Margin="0,8,0,0"
                       Text="Ürün ve marka adları (MSI, Mystic Light, ASUS, ROG, EK, Windows) sahiplerine aittir; yalnızca uyumluluğu belirtmek için kullanılmıştır." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
